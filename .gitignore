# Design-workspace assets — research & design review docs, the mockup
# gallery, and its HTML viewer. Local only; not shipped on GitHub.
docs/
previews/
review.html
review-inline.html

# Python tooling
__pycache__/
*.pyc

# Node tooling (tools/build.js deps)
node_modules/

.DS_Store

# GSettings build artefact — regenerate locally:
#   glib-compile-schemas extension/schemas/
# Committing it is how a stale schema silently overrides the XML (the
# emoji-tone range fix would be undone by the old binary).
extension/schemas/gschemas.compiled

*.patch
